{
  "name": "code-context-mcp",
  "version": "1.0.0",
  "description": "Standalone RAG + MCP Code Context Server for AI Coding Assistants",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "code-context-mcp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "migrate": "tsx src/cli/index.ts db:migrate",
    "db:status": "tsx src/cli/index.ts db:status",
    "project:add": "tsx src/cli/index.ts project:add",
    "project:list": "tsx src/cli/index.ts project:list",
    "index:full": "tsx src/cli/index.ts index:full",
    "index:incremental": "tsx src/cli/index.ts index:incremental",
    "index:watch": "tsx src/cli/index.ts index:watch",
    "search": "tsx src/cli/index.ts search",
    "context": "tsx src/cli/index.ts context",
    "impact": "tsx src/cli/index.ts impact",
    "status": "tsx src/cli/index.ts status",
    "health": "tsx src/cli/index.ts health",
    "dashboard": "tsx src/cli/index.ts dashboard",
    "dev": "tsx src/cli/index.ts dashboard",
    "mcp": "tsx src/cli/index.ts mcp",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "rag",
    "mcp",
    "model-context-protocol",
    "code-search",
    "ast",
    "mysql",
    "qdrant",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "@babel/types": "^7.26.9",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@qdrant/js-client-rest": "^1.13.0",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "ignore": "^7.0.3",
    "mysql2": "^3.12.0",
    "php-parser": "^3.1.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
