# ==============================================================================
# code-context-mcp Environment Configuration
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_LOG_LEVEL=info

# MySQL 8.4 Configuration (Required relational database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=code_context_mcp
DB_CONNECTION_LIMIT=10

# Qdrant Vector Database Configuration
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=code_chunks

# Ollama Embedding Model Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSIONS=768
OLLAMA_BATCH_SIZE=32

# Local Storage Directory for cache, temporary index state, and logs
LOCAL_DATA_DIR=./local-data

# MCP Server Configuration
MCP_SERVER_NAME=code-context-mcp
MCP_SERVER_VERSION=1.0.0

# Search & Retrieval Configuration
SEARCH_EXACT_WEIGHT=0.35
SEARCH_FULLTEXT_WEIGHT=0.35
SEARCH_VECTOR_WEIGHT=0.30
SEARCH_MAX_RESULTS=20

